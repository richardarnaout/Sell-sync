    "dev:demo": "node scripts/dev-demo.mjs",
    "verif:demo": "tsc -p scripts/tsconfig.verif.json && node .verif/scripts/verif-demo.js",
    "verif:demo-build": "node scripts/verif-demo-build.mjs",
    "demo:images": "node scripts/demo-images.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.3",
    "@supabase/supabase-js": "^2.105.4",
    "ai": "^7.0.8",
