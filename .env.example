# Copier en .env.local (non versionné) et remplir. En prod : réglages du projet Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret long et aléatoire ; Vercel Cron l'envoie à /api/keepalive (Authorization: Bearer ...)
CRON_SECRET=
# Gemini (routes IA)
GOOGLE_GENERATIVE_AI_API_KEY=
# Import mails Vinted (T-018.8) — SERVEUR uniquement, jamais NEXT_PUBLIC_
# Clé service Supabase (Settings → API → service_role) : écrit pending_sales depuis le webhook
SUPABASE_SERVICE_ROLE_KEY=
# Secret partagé avec apps-script/Code.gs (en-tête x-import-secret) ; protège aussi /api/import/extract
IMPORT_SECRET=
# user_id SellSync qui reçoit les ventes ; ou IMPORT_USER_MAP={"adresse@gmail.com":"uuid",...} si plusieurs comptes
IMPORT_USER_ID=
IMPORT_USER_MAP=
